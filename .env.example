# Copy to .env and fill in. NEVER commit a filled-in .env.
# Local demo needs none of these — the deterministic engine runs with no keys.
DATABASE_URL=sqlite:///./codesentry.db
# DATABASE_URL=postgresql+psycopg2://codesentry:codesentry@localhost:5432/codesentry
REDIS_URL=
CELERY_BROKER_URL=
# REQUIRED in production: a long random secret. The dev default is insecure.
CODESENTRY_JWT_SECRET=change-me-to-a-long-random-secret
# GitHub App (see docs/GITHUB_SETUP.md)
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PAT fallback for posting comments/checks in the demo (App token preferred)
GITHUB_TOKEN=
# LLM (optional — deterministic rule engine is the default)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_HOST=
LLM_PROVIDER=deterministic
EMBEDDING_PROVIDER=hash
FRONTEND_URL=http://localhost:5173
